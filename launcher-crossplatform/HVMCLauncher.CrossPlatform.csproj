<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HVMC</AssemblyName>
    <RootNamespace>HVMCLauncher.CrossPlatform</RootNamespace>
    <HVMCVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\version.txt').Trim())</HVMCVersion>
    <Version>$(HVMCVersion)</Version>
    <AssemblyVersion>$(HVMCVersion)</AssemblyVersion>
    <FileVersion>$(HVMCVersion)</FileVersion>
    <InformationalVersion>$(HVMCVersion)</InformationalVersion>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
  </ItemGroup>
</Project>
